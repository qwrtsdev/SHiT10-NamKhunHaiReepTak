{
  "manifest_version": 3,
  "name": "น้ำขึ้นให้รีบตัก",
  "version": "1.0",
  "description": "Every prompts you send uses water! and the data centers caused global warming.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "action": {
    "default_title": "น้ำขึ้นให้รีบตัก",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/config.js",
        "src/content/core.js",
        "src/shared/sim.js",
        "src/content/tilt/camera.js",
        "src/content/tilt/tilt.js",
        "src/content/effects/waves.js",
        "src/content/effects/drops.js",
        "src/content/effects/scoop.js",
        "src/content/effects/percent.js",
        "src/content/effects/lockout.js",
        "src/content/effects/drained.js",
        "src/content/effects/alerts.js",
        "src/content/effects/muffle.js",
        "src/content/chat.js",
        "src/content/sites/claude.js",
        "src/content/sites/chatgpt.js",
        "src/content/sites/gemini.js",
        "src/content/sites/others.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}