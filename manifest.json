{
  "manifest_version": 3,
  "name": "shitx flood",
  "version": "1.0",
  "description": "Water rises on every site each time you send a prompt on claude.ai.",
  "permissions": ["storage"],
  "action": { "default_title": "Drain the water" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
